# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ascendion_seat_booking

# JWT
JWT_SECRET=ascendion-seat-booking-secret-key-2024
JWT_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Email (SMTP - Microsoft 365 / Outlook)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=<your_email>
SMTP_PASS=<your_app_password>
EMAIL_FROM=noreply@ascendion.com

# Microsoft Graph API (OneDrive)
AZURE_TENANT_ID=<your_tenant_id>
AZURE_CLIENT_ID=<your_client_id>
AZURE_CLIENT_SECRET=<your_client_secret>
ONEDRIVE_FILE_ID=<your_excel_file_id>

# Frontend URL
CLIENT_URL=http://localhost:4200

# Allowed Email Domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=ascendion.com,nitor.com
